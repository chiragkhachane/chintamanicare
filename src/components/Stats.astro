---
import { t, type Lang } from "../content/i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);
---

<section class="section band stats" aria-label="By the numbers">
  <div class="container-x">
    <ul class="stats-grid">
      {c.stats.map((s) => (
        <li class="stat" data-reveal="up">
          <span class="stat-value">
            <span data-counter data-to={s.value} data-decimals={s.decimals} data-suffix={s.suffix}>{s.value.toFixed(s.decimals)}{s.suffix}</span>
          </span>
          <span class="stat-label">{s.label}</span>
          {s.note && <span class="stat-note">{s.note}</span>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .stats { padding-block: clamp(3rem, 6vw, 5rem); }
  .stats-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem 1.5rem;
  }
  @media (min-width: 860px) { .stats-grid { grid-template-columns: repeat(4, 1fr); } }

  .stat { display: flex; flex-direction: column; gap: 0.35rem; position: relative; }
  @media (min-width: 860px) {
    .stat + .stat { padding-left: 1.5rem; }
    .stat + .stat::before { content: ""; position: absolute; left: 0; top: 0.2rem; bottom: 0.2rem; width: 1px; background: var(--line); }
  }
  .stat-value {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(2.6rem, 5vw, 3.6rem); line-height: 1; color: #fff;
    letter-spacing: -0.02em;
  }
  .stat-label { font-size: 0.98rem; font-weight: 500; color: var(--muted); }
  .stat-note { font-size: 0.82rem; color: var(--vital); font-weight: 600; }
  :is(html[lang="mr"], html[lang="hi"]) .stat-value { font-size: clamp(2.2rem, 4.4vw, 3rem); }
</style>
