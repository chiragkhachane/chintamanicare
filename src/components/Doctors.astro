---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import drTushar from "../assets/doctors/dr-tushar-khachane.png";
import drBabita from "../assets/doctors/dr-babita-khachane.png";
import { site } from "../content/site";
import { t, localePath, type Lang } from "../content/i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);
const photos: Record<string, ImageMetadata> = { tushar: drTushar, babita: drBabita };
const phone = site.contact.phones[1];
---

<section id="doctors" class="section surface-mint doctors">
  <div class="container-x">
    <header class="sec-head" data-reveal="up">
      <p class="kicker"><span class="cross" aria-hidden="true"></span>{c.doctorsIntro.kicker}</p>
      <h2>{c.doctorsIntro.heading}</h2>
      <p class="sec-sub measure">{c.doctorsIntro.sub}</p>
    </header>

    <div class="doc-grid">
      {c.doctors.map((doc) => (
        <article class="doc card lift" data-reveal="up">
          <div class="doc-photo">
            <Image src={photos[doc.id]} alt={doc.name} widths={[360, 520]} sizes="(max-width: 720px) 90vw, 320px" class="doc-img" />
            <span class="doc-exp"><Icon name="ph:medal" class="h-[0.9rem] w-[0.9rem]" />{doc.experience}</span>
          </div>
          <div class="doc-body">
            <h3 class="doc-name">{doc.name}</h3>
            <p class="doc-role">{doc.role}</p>
            <p class="doc-cred"><Icon name="ph:certificate" class="h-4 w-4" />{doc.credentials}</p>
            <ul class="doc-focus" aria-label={doc.focusLabel}>
              {doc.focus.map((f) => <li class="focus-chip">{f}</li>)}
            </ul>
            <p class="doc-bio">{doc.bio}</p>
            <div class="doc-actions">
              <a href={localePath(lang, `/doctors/${doc.id}/`)} class="btn btn-primary">{c.meetCta}<Icon name="ph:arrow-right" class="h-[1.05rem] w-[1.05rem]" /></a>
              <a href={`tel:${phone.tel}`} class="btn btn-ghost"><Icon name="ph:phone-call" class="h-[1.05rem] w-[1.05rem]" />{c.common.call}</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .sec-head { margin-bottom: 2.6rem; }
  .sec-head .kicker { margin-bottom: 1rem; }
  .sec-head h2 { font-size: clamp(1.9rem, 3.6vw, 2.9rem); }
  .sec-sub { margin-top: 0.9rem; color: var(--muted); font-size: 1.06rem; }

  .doc-grid { display: grid; gap: 1.6rem; }
  @media (min-width: 760px) { .doc-grid { grid-template-columns: 1fr 1fr; } }

  .doc { overflow: hidden; display: grid; grid-template-columns: 1fr; }
  @media (min-width: 520px) { .doc { grid-template-columns: 0.78fr 1.22fr; } }

  .doc-photo { position: relative; background: var(--mint-2); overflow: hidden; }
  .doc-img { display: block; width: 100%; height: 100%; min-height: 240px; object-fit: cover; object-position: top center; transition: transform 0.6s var(--ease-out-expo); }
  .doc:hover .doc-img { transform: scale(1.045); }
  .doc-exp {
    position: absolute; top: 0.8rem; left: 0.8rem;
    display: inline-flex; align-items: center; gap: 0.32rem;
    padding: 0.35rem 0.65rem; border-radius: 9999px;
    background: color-mix(in oklab, #fff 90%, transparent); backdrop-filter: blur(4px);
    border: 1px solid var(--line); color: var(--brand-strong);
    font-size: 0.78rem; font-weight: 700;
  }
  .doc-body { padding: 1.5rem 1.5rem 1.6rem; display: flex; flex-direction: column; }
  .doc-name { font-size: 1.45rem; }
  .doc-role { margin-top: 0.3rem; font-size: 0.92rem; font-weight: 600; color: var(--brand-strong); }
  .doc-cred { margin-top: 0.7rem; display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.86rem; color: var(--muted); font-weight: 500; }
  .doc-focus { margin-top: 0.9rem; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .focus-chip {
    font-size: 0.78rem; font-weight: 600; color: var(--brand-strong);
    background: var(--mint); border: 1px solid var(--line);
    padding: 0.28rem 0.6rem; border-radius: 9999px;
  }
  .doc-bio { margin-top: 1rem; font-size: 0.96rem; color: var(--fg); line-height: 1.6; }
  .doc-actions { margin-top: auto; padding-top: 1.3rem; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .doc-actions .btn { padding-block: 0.65rem; font-size: 0.88rem; }
</style>
