---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import drTushar from "../assets/doctors/dr-tushar-khachane.png";
import drBabita from "../assets/doctors/dr-babita-khachane.png";
import Nav from "./Nav.astro";
import Journey from "./Journey.astro";
import Testimonials from "./Testimonials.astro";
import Appointment from "./Appointment.astro";
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import { site, whatsappLink } from "../content/site";
import { t, localePath, type Lang } from "../content/i18n";

interface Props { lang: Lang; id: "tushar" | "babita"; path: string }
const { lang, id, path } = Astro.props;
const c = t(lang);
const doc = c.doctors.find((d) => d.id === id)!;
const group = c.services.find((g) => g.key === (id === "tushar" ? "surgical" : "dental"))!;
const photos = { tushar: drTushar, babita: drBabita };
const phone = site.contact.phones[1];
const waMsg = `${doc.name} - ${c.appointment.kicker}`;
---

<Nav lang={lang} path={path} />
<main id="main">
  <section id="top" class="dhero">
    <div class="dhero-bg" aria-hidden="true"></div>
    <div class="container-x dhero-grid">
      <div class="dhero-copy">
        <a class="back" href={localePath(lang, "/")}><Icon name="ph:arrow-left" class="h-4 w-4" />{c.dpage.backHome}</a>
        <span class="pill-label"><span class="cross" aria-hidden="true"></span>{group.label}</span>
        <h1 class="dhero-name">{doc.name}</h1>
        <p class="dhero-role">{doc.role}</p>
        <p class="dhero-tag measure">{doc.tagline}</p>

        <ul class="dhero-meta">
          <li><Icon name="ph:certificate" class="h-[1.05rem] w-[1.05rem]" />{doc.credentials}</li>
          <li><Icon name="ph:medal" class="h-[1.05rem] w-[1.05rem]" />{doc.experience}</li>
          <li><span class="stars" aria-hidden="true">{[0,1,2,3,4].map(() => <Icon name="ph:star-fill" class="h-[0.85rem] w-[0.85rem]" />)}</span>{site.contact.rating.value}</li>
        </ul>

        <div class="dhero-cta">
          <a href={site.href.appointment} data-magnetic class="btn btn-primary"><Icon name="ph:calendar-plus" class="h-[1.15rem] w-[1.15rem]" />{c.common.book}</a>
          <a href={`tel:${phone.tel}`} class="btn btn-ghost"><Icon name="ph:phone-call" class="h-[1.15rem] w-[1.15rem]" />{c.common.call}</a>
          <a href={whatsappLink(waMsg)} target="_blank" rel="noopener" class="btn btn-whatsapp"><Icon name="ph:whatsapp-logo" class="h-[1.15rem] w-[1.15rem]" />{c.common.whatsapp}</a>
        </div>
      </div>

      <div class="dhero-media" data-reveal="fade">
        <div class="dhero-accent" aria-hidden="true"></div>
        <figure class="dhero-frame">
          <Image src={photos[id]} alt={doc.name} widths={[420, 640, 820]} sizes="(max-width: 1024px) 90vw, 460px" class="dhero-photo" />
        </figure>
        <div class="float-card">
          <span class="fc-ic"><Icon name="ph:pulse" class="h-5 w-5" /></span>
          <div>
            <span class="fc-k">{doc.experience}</span>
            <span class="fc-v">{c.dpage.specialist}</span>
          </div>
        </div>
        <div class="open-badge" data-open-badge data-open={c.common.openNow} data-opens-today={c.common.opensToday} data-opens-day={c.common.opensDay} data-closed={c.common.closed}>
          <span class="live-dot" aria-hidden="true"></span>
          <span data-open-label>{c.common.openNow}</span>
        </div>
      </div>
    </div>
  </section>

  <section id="about" class="section dabout">
    <div class="container-x dabout-grid">
      <div data-reveal="up">
        <p class="kicker"><span class="cross" aria-hidden="true"></span>{c.dpage.about.replace("{name}", doc.name)}</p>
        <p class="dabout-body">{doc.bio}</p>
      </div>
      <ul class="dabout-focus" data-reveal="up" aria-label={doc.focusLabel}>
        {doc.focus.map((f) => (
          <li><Icon name="ph:check-circle-fill" class="h-5 w-5" />{f}</li>
        ))}
      </ul>
    </div>
  </section>

  <section id="services" class="section surface-mint dsvc">
    <div class="container-x">
      <header class="sec-head" data-reveal="up">
        <p class="kicker"><span class="cross" aria-hidden="true"></span>{c.dpage.services}</p>
        <h2>{group.label}</h2>
        <p class="sec-sub measure">{group.blurb}</p>
      </header>
      <ul class="dsvc-grid">
        {group.items.map((item) => (
          <li class="card lift dsvc-card" data-reveal="up">
            <span class="dsvc-ic"><Icon name={item.icon} class="h-[1.4rem] w-[1.4rem]" /></span>
            <h3 class="dsvc-title">{item.title}</h3>
            <p class="dsvc-body">{item.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Journey lang={lang} />
  <Testimonials lang={lang} />
  <Appointment lang={lang} />
  <Contact lang={lang} />
</main>
<Footer lang={lang} path={path} />

<style>
  .dhero { position: relative; overflow: hidden; padding-top: 92px; }
  .dhero-bg {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background:
      radial-gradient(56% 56% at 86% 4%, color-mix(in oklab, var(--brand) 13%, transparent), transparent 70%),
      radial-gradient(46% 40% at -2% 100%, var(--mint), transparent 76%);
  }
  .dhero-grid {
    position: relative; z-index: 1; display: grid; gap: 2.5rem; align-items: center;
    padding-block: clamp(2rem, 4vw, 3.5rem) clamp(3rem, 6vw, 5rem); min-height: min(82vh, 820px);
  }
  @media (min-width: 1024px) { .dhero-grid { grid-template-columns: 1.05fr 0.95fr; gap: 3.5rem; } }

  .back {
    display: inline-flex; align-items: center; gap: 0.4rem; margin-bottom: 1.4rem;
    font-size: 0.9rem; font-weight: 600; color: var(--muted);
    padding: 0.45rem 0.9rem; border-radius: 9999px; border: 1px solid var(--line); background: var(--surface);
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .back:hover { color: var(--brand-strong); border-color: var(--brand); }
  .pill-label {
    display: inline-flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem;
    padding: 0.4rem 0.85rem; border-radius: 9999px; background: var(--mint);
    color: var(--brand-strong); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
  }
  :is(html[lang="mr"], html[lang="hi"]) .pill-label { text-transform: none; letter-spacing: 0; }
  .pill-label .cross { width: 13px; height: 13px; color: var(--brand); }

  .dhero-name { font-size: clamp(2.4rem, 5vw, 4rem); font-weight: 500; letter-spacing: -0.02em; line-height: 1.04; color: var(--ink); }
  :is(html[lang="mr"], html[lang="hi"]) .dhero-name { line-height: 1.22; font-size: clamp(2rem, 4.4vw, 3.2rem); }
  .dhero-role { margin-top: 0.6rem; font-size: 1rem; font-weight: 600; color: var(--brand-strong); }
  .dhero-tag { margin-top: 1rem; font-size: 1.1rem; color: var(--muted); line-height: 1.6; }

  .dhero-meta { margin-top: 1.5rem; display: flex; flex-wrap: wrap; gap: 0.6rem 1.4rem; }
  .dhero-meta li { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.92rem; font-weight: 600; color: var(--ink); }
  .dhero-meta .stars { margin-right: 0.1rem; }

  .dhero-cta { margin-top: 2rem; display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .dhero-media { position: relative; }
  .dhero-accent { position: absolute; inset: 1.6rem -0.8rem -1.4rem 1.8rem; z-index: 0; border-radius: 26px; background: linear-gradient(155deg, color-mix(in oklab, var(--brand) 20%, #fff), var(--mint)); border: 1px solid var(--line); }
  .dhero-frame { position: relative; z-index: 1; margin: 0; border-radius: 22px; overflow: hidden; border: 1px solid var(--line); box-shadow: 0 30px 60px -34px rgb(16 30 64 / 0.5); background: var(--mint-2); }
  .dhero-photo { display: block; width: 100%; aspect-ratio: 5 / 5.4; object-fit: cover; object-position: top center; }

  .float-card {
    position: absolute; z-index: 2; left: -0.8rem; bottom: 2rem;
    display: inline-flex; align-items: center; gap: 0.7rem;
    padding: 0.8rem 1rem; border-radius: 16px; background: #fff; border: 1px solid var(--line);
    box-shadow: 0 20px 40px -24px rgb(16 30 64 / 0.5);
  }
  .fc-ic { display: grid; place-items: center; height: 38px; width: 38px; border-radius: 11px; background: var(--mint); color: var(--brand-strong); }
  .fc-k { display: block; font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; color: var(--ink); line-height: 1.1; }
  .fc-v { display: block; font-size: 0.78rem; color: var(--muted); }
  .open-badge {
    position: absolute; z-index: 2; top: 1rem; right: -0.4rem;
    display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.85rem; border-radius: 9999px;
    background: #fff; border: 1px solid var(--line); box-shadow: 0 16px 34px -20px rgb(16 30 64 / 0.45);
    font-size: 0.82rem; font-weight: 600; color: var(--ink);
  }
  .open-badge.is-closed .live-dot { background: var(--muted); }
  @media (max-width: 1023px) { .dhero-media { max-width: 440px; margin-inline: auto; } }

  /* About */
  .dabout-grid { display: grid; gap: 2.5rem; }
  @media (min-width: 880px) { .dabout-grid { grid-template-columns: 1.4fr 1fr; gap: 3.5rem; align-items: center; } }
  .kicker { margin-bottom: 1rem; }
  .dabout-body { font-size: 1.15rem; line-height: 1.7; color: var(--fg); }
  .dabout-focus { display: grid; gap: 0.8rem; }
  .dabout-focus li { display: flex; align-items: center; gap: 0.7rem; font-size: 1.02rem; font-weight: 500; color: var(--ink); }
  .dabout-focus svg { color: var(--brand); flex: none; }

  /* Services */
  .sec-head { margin-bottom: 2.4rem; }
  .sec-head .kicker { margin-bottom: 1rem; }
  .sec-head h2 { font-size: clamp(1.9rem, 3.6vw, 2.9rem); }
  .sec-sub { margin-top: 0.8rem; color: var(--muted); font-size: 1.04rem; }
  .dsvc-grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(252px, 1fr)); }
  .dsvc-card { padding: 1.4rem 1.4rem 1.5rem; }
  .dsvc-ic { display: grid; place-items: center; height: 46px; width: 46px; border-radius: 13px; background: var(--mint); color: var(--brand-strong); margin-bottom: 1rem; transition: background-color 0.3s ease, color 0.3s ease, transform 0.3s var(--ease-out-expo); }
  .dsvc-card:hover .dsvc-ic { background: var(--brand-strong); color: #fff; transform: scale(1.06) rotate(-3deg); }
  .dsvc-title { font-size: 1.12rem; }
  .dsvc-body { margin-top: 0.5rem; color: var(--muted); font-size: 0.95rem; line-height: 1.6; }
</style>
