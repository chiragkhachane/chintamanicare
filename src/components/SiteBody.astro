---
import Nav from "./Nav.astro";
import Hero from "./Hero.astro";
import TrustMarquee from "./TrustMarquee.astro";
import About from "./About.astro";
import Doctors from "./Doctors.astro";
import Services from "./Services.astro";
import Journey from "./Journey.astro";
import Testimonials from "./Testimonials.astro";
import Appointment from "./Appointment.astro";
import Contact from "./Contact.astro";
import Footer from "./Footer.astro";
import type { Lang } from "../content/i18n";

interface Props { lang: Lang; path?: string }
const { lang, path = "/" } = Astro.props;
---

<Nav lang={lang} path={path} />
<main id="main">
  <Hero lang={lang} />
  <TrustMarquee lang={lang} />
  <Doctors lang={lang} />
  <Services lang={lang} />
  <Testimonials lang={lang} />
  <About lang={lang} />
  <Journey lang={lang} />
  <Appointment lang={lang} />
  <Contact lang={lang} />
</main>
<Footer lang={lang} path={path} />
