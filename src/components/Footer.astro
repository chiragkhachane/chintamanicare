---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import logo from "../assets/brand/logo.png";
import { site, whatsappLink } from "../content/site";
import { t, LANGS, localePath, type Lang } from "../content/i18n";

interface Props { lang: Lang; path?: string }
const { lang, path = "/" } = Astro.props;
const c = t(lang);
const phone = site.contact.phones[1];
---

<footer class="band footer">
  <div class="container-x">
    <div class="footer-top">
      <div class="footer-brand">
        <a href={localePath(lang, "/")} class="footer-logo" aria-label={site.legalName}>
          <Image src={logo} alt={site.legalName} height={112} densities={[1, 2]} class="footer-logo-img" />
        </a>
        <p class="footer-tag">{c.footer.tagline}</p>
        <address class="footer-addr">
          <Icon name="ph:map-pin" class="h-4 w-4" />
          <span>{c.contact.address.join(", ")}</span>
        </address>
      </div>

      <nav class="footer-col" aria-label={c.footer.exploreHeading}>
        <h2 class="footer-h">{c.footer.exploreHeading}</h2>
        <ul>
          {c.footer.links.map((l) => <li><a href={localePath(lang, l.href)}>{l.label}</a></li>)}
        </ul>
      </nav>

      <div class="footer-col">
        <h2 class="footer-h">{c.footer.reachHeading}</h2>
        <ul class="footer-reach">
          <li><a href={`tel:${phone.tel}`}><Icon name="ph:phone-call" class="h-4 w-4" />{phone.label}</a></li>
          <li><a href={whatsappLink()} target="_blank" rel="noopener"><Icon name="ph:whatsapp-logo" class="h-4 w-4" />{c.common.whatsapp}</a></li>
          <li><a href={`mailto:${site.contact.email}`}><Icon name="ph:envelope-simple" class="h-4 w-4" />{site.contact.email}</a></li>
          <li><a href={site.contact.mapLink} target="_blank" rel="noopener"><Icon name="ph:navigation-arrow" class="h-4 w-4" />{c.common.directions}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-rights">{c.footer.rights}</p>
      <ul class="footer-langs">
        {LANGS.map((l) => (
          <li><a href={localePath(l.code, path)} class:list={{ active: l.code === lang }}>{l.native}</a></li>
        ))}
      </ul>
    </div>
  </div>
  <div class="footer-ghost" aria-hidden="true">{site.shortName}</div>
</footer>

<style>
  .footer { position: relative; overflow: hidden; background: linear-gradient(180deg, var(--brand-deep), var(--brand-deeper)); }
  .footer .container-x { position: relative; z-index: 1; padding-block: clamp(3rem, 6vw, 4.5rem) 2rem; }
  .footer-top { display: grid; gap: 2.5rem; }
  @media (min-width: 760px) { .footer-top { grid-template-columns: 1.5fr 1fr 1.3fr; gap: 3rem; } }

  .footer-logo { display: inline-flex; background: #fff; border-radius: 14px; padding: 0.6rem 0.95rem; box-shadow: 0 12px 30px -18px rgb(0 0 0 / 0.5); }
  .footer-logo-img { height: 46px; width: auto; display: block; }
  .footer-tag { margin-top: 1.1rem; color: var(--muted); font-size: 1rem; max-width: 34ch; }
  .footer-addr { margin-top: 0.9rem; display: flex; gap: 0.5rem; font-style: normal; font-size: 0.92rem; line-height: 1.6; color: color-mix(in oklab, #fff 70%, transparent); max-width: 40ch; }
  .footer-addr .h-4 { color: var(--vital); flex: none; margin-top: 0.15rem; }

  .footer-h { font-family: var(--font-sans); font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--vital); margin-bottom: 1rem; }
  :is(html[lang="mr"], html[lang="hi"]) .footer-h { text-transform: none; letter-spacing: 0; font-size: 0.95rem; }
  .footer-col ul { display: grid; gap: 0.7rem; }
  .footer-col a { color: color-mix(in oklab, #fff 86%, transparent); font-size: 0.96rem; transition: color 0.2s ease; }
  .footer-col a:hover { color: #fff; }
  .footer-reach a { display: inline-flex; align-items: center; gap: 0.55rem; }
  .footer-reach .h-4 { color: var(--vital); }

  .footer-bottom {
    margin-top: 2.6rem; padding-top: 1.5rem; border-top: 1px solid var(--line);
    display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between;
  }
  .footer-rights { font-size: 0.85rem; color: color-mix(in oklab, #fff 62%, transparent); }
  .footer-langs { display: flex; gap: 0.4rem; }
  .footer-langs a { display: inline-block; padding: 0.3rem 0.7rem; border-radius: 9999px; font-size: 0.85rem; color: color-mix(in oklab, #fff 80%, transparent); border: 1px solid transparent; }
  .footer-langs a:hover { border-color: color-mix(in oklab, #fff 30%, transparent); }
  .footer-langs a.active { background: color-mix(in oklab, #fff 14%, transparent); color: #fff; font-weight: 600; }

  /* Giant ghost wordmark, anchored to the bottom edge. */
  .footer-ghost {
    position: absolute; left: 50%; bottom: -0.18em; transform: translateX(-50%);
    z-index: 0; margin: 0; pointer-events: none; white-space: nowrap;
    font-family: var(--font-display); font-weight: 600; line-height: 0.8;
    font-size: clamp(5rem, 22vw, 20rem);
    color: color-mix(in oklab, #fff 6%, transparent);
  }
</style>
